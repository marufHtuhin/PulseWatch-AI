# PulseWatch AI backend — copy to .env and adjust. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO

# MySQL-first; SQLite fallback for local testing.
DATABASE_URL=sqlite:///./pulsewatch.db
# DATABASE_URL=mysql+pymysql://pulsewatch:CHANGE_ME@127.0.0.1:3306/pulsewatch

# JWT signing key (HS256). REQUIRED in production (APP_ENV=production
# refuses to start with the dev default below). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# Optional admin bootstrap: when BOTH are set, startup creates this user
# (if missing) and assigns all ownerless pre-v4 monitors + one ownerless
# settings row to them. Only needed when upgrading a pre-v4 deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Brevo (password-reset emails). Without both, the app still
# runs but forgot-password emails are not sent (a warning is logged).
# EMAIL_FROM must be a sender address verified in the Brevo account
# (a verified Gmail address works — no domain needed) or sends fail.
# The same Brevo account/key as FarmMarket works.
BREVO_API_KEY=
EMAIL_FROM=

# Optional: without it, alerts use deterministic fallback templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Telegram notifications. Fallback credentials — values set in the
# app's Settings UI take precedence over these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:5173

# Dev-only: allows checks against loopback/private URLs. NEVER true in production.
ALLOW_LOCAL_URLS=false

MAX_CONCURRENCY=10
MAX_BATCH_SIZE=50
MAX_RESPONSE_READ_BYTES=10485760

# Set to 1 under pytest so the scheduler does not start.
PULSEWATCH_TESTING=0
